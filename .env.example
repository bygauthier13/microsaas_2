# ─────────────────────────────────────────────────────────────────────────────
# Ensign — environment variables
# Copy to .env.local for local development. Every external service is optional:
# when a key is missing (or still "replace_me") the app falls back to a safe
# local implementation so the whole product can be demonstrated offline.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL (used in emails, Stripe redirects, sitemap, OpenGraph)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Leave empty to use an embedded Postgres (PGlite) stored in ./.data/pglite.
# Production: any Postgres URL (Supabase, Neon, RDS...). Run `npm run db:migrate`
# in your deploy step, or set AUTO_MIGRATE=true.
DATABASE_URL=
PGLITE_DIR=./.data/pglite
AUTO_MIGRATE=false

# ── Security ────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Encrypts every uploaded KYC document (AES-256-GCM). REQUIRED in production.
ENCRYPTION_KEY=replace_me
# Bearer token for /api/cron/daily (Vercel Cron sends it automatically when set
# as CRON_SECRET in the project). Generate: openssl rand -hex 32
CRON_SECRET=replace_me
# Comma-separated emails that can open the founder metrics page (/app/admin)
ADMIN_EMAILS=
# Local development helpers (dev email outbox at /dev/outbox). NEVER enable in production.
ENABLE_DEV_TOOLS=false

# ── Billing (Stripe) ────────────────────────────────────────────────────────
# Without a real key, checkout runs in "mock" mode (simulated, no charge).
STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me
STRIPE_PRICE_STARTER_MONTHLY=replace_me
STRIPE_PRICE_STARTER_YEARLY=replace_me
STRIPE_PRICE_BROKERAGE_MONTHLY=replace_me
STRIPE_PRICE_BROKERAGE_YEARLY=replace_me

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Without a key, emails are stored in the outbox table and printed to the console.
EMAIL_API_KEY=replace_me
EMAIL_FROM="Ensign <compliance@yourdomain.com>"

# ── Sanctions & PEP screening (OpenSanctions) ───────────────────────────────
# https://www.opensanctions.org/api/ — €0.10 per match call.
# Without a key, screening uses a clearly-labelled FICTIONAL demo watchlist.
OPENSANCTIONS_API_KEY=replace_me
OPENSANCTIONS_DATASET=default

# ── Product analytics (optional, PostHog EU) ────────────────────────────────
# Events are always stored in the analytics_events table; PostHog is a mirror.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
